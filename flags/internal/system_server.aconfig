package: "com.android.bluetooth.beta.flags"
container: "com.android.bt"

flag {
    name: "system_server_direct_switch"
    namespace: "com_android_bt"
    description: "Never post the user switch request. Instead handle it immediately"
    bug: "489876039"
}

flag {
    name: "system_server_simple_mac_permission_enforcement"
    namespace: "com_android_bt"
    description: "Rely to simple request to enforce permission and throw exception when they are missing"
    bug: "497068035"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

